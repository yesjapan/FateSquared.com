# Cloudflare Pages headers. Ignored by GitHub Pages (served as a plain file),
# so this is safe to keep in place during and after the migration.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Fingerprint-free filenames, so keep these short enough to re-pull on change
# but long enough to make repeat visits instant.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The font never changes without a filename change.
/assets/FateSquaredR-Regular.woff2
  Cache-Control: public, max-age=31536000, immutable
/assets/FateSquaredR-Regular.ttf
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/script.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
